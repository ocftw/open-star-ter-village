# Copy this file to fly.toml and replace the app name and URLs before deploying.
app = "your-village-app"
primary_region = "sin"

[build]
  dockerfile = "Dockerfile"

  [build.args]
    NEXT_PUBLIC_GAME_SERVER_URL = "https://your-village-app.fly.dev:3001"

[env]
  NEXT_PUBLIC_GAME_SERVER_URL = "https://your-village-app.fly.dev:3001"
  # Optional RFC 009 persistence, after #446 and #447 ship:
  # MATCH_RESUME_WINDOW_HOURS = "24"
  # Store DATABASE_URL, MATCH_PERSISTENCE=member (or off), and
  # GAME_SERVER_AUTH_SECRET as runtime Fly secrets, never as build args.
  # Use <database-app>.internal in DATABASE_URL. The database runs in a
  # separate private app; see fly.postgres.toml.example and the webapp README.

[[services]]
  protocol = "tcp"
  internal_port = 3000
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[services.ports]]
    port = 80
    handlers = ["http"]
    force_https = true

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]

[[services]]
  protocol = "tcp"
  internal_port = 3001
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[services.http_checks]]
    interval = "15s"
    timeout = "2s"
    method = "GET"
    path = "/health"
    protocol = "http"

  [[services.ports]]
    port = 3001
    handlers = ["tls", "http"]

[vm]
  cpu_kind = "shared"
  cpus = 1
  memory_mb = 256
