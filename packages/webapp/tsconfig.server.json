{
  "compilerOptions": {
    "target": "ES2017",
    "module": "NodeNext",
    "lib": ["ES2017"],
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/server.ts", "./src/env.ts", "./src/game/**/*.ts", "./src/server/persistence/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
