{
  "name": "open-star-ter-village",
  "version": "0.0.1",
  "author": "Ben Liu <ben196888@gmail.com>, renovirtony <renovirtony@gmail.com>",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "webapp": "pnpm --filter @open-star-ter-village/webapp",
    "homepage": "pnpm --filter @open-starter-village/homepage",
    "all:dev": "pnpm --recursive --parallel run dev:all",
    "all:build": "pnpm --recursive run build",
    "all:start": "pnpm --recursive --parallel run start:all",
    "all:lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "ts-jest": "^29.4.6"
  }
}
