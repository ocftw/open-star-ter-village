{
  "name": "open-star-ter-village",
  "version": "0.0.1",
  "author": "Ben Liu <ben196888@gmail.com>, renovirtony <renovirtony@gmail.com>",
  "private": true,
  "packageManager": "yarn@3.4.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "webapp": "yarn workspace @open-star-ter-village/webapp",
    "all:dev": "yarn workspaces foreach -pi run dev",
    "all:build": "yarn workspaces foreach -pt run build",
    "all:start": "yarn workspaces foreach -pt run start",
    "all:lint": "yarn workspaces foreach -pt run lint"
  },
  "resolutions": {
    "reselect": "^5.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "ts-jest": "^29.4.6"
  }
}
